{
  "expo": {
    "name": "Campusbite",
    "slug": "campus-canteen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "campuscanteen",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.campusbite.canteen"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F56B28",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.campusbite.canteen"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "imageWidth": 76,
          "backgroundColor": "#FAF9F6",
          "image": "./assets/images/splash-icon.png"
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "cameraPermission": false,
          "photosPermission": "Allow Campusbite to select meal photos for the canteen menu.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
